# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，切勿提交）

# DeepSeek API 密钥（必填）——在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-your-key-here

# API 端点（可选）。留空 = 官方公开端点 https://api.deepseek.com
# DEEPSEEK_BASE_URL=

# 模型 id：由你的 API 端点决定（deepseek-chat / deepseek-reasoner / deepseek-v4-flash ...）
DSH_MODEL=deepseek-chat

# 单次任务输出 token 上限
DSH_MAX_TOKENS=8192

# 评分阈值：>=75 推荐面试；50-74 待定；<50 建议淘汰
SCORE_RECOMMEND=75
SCORE_PENDING=50

# Agent 语义复核时最多在规则分基础上调整的分数（超出即拒绝，防主观漂移）
MAX_SEMANTIC_ADJUST=10

# 上传简历文件大小上限（MB）
MAX_UPLOAD_MB=5
